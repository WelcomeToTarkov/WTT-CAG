      "en": {
        "name": "T.REX ARMS AC1 plate carrier (MultiCam)",
        "shortName": "AC1",
        "description": "The AC1 is a minimalist plate carrier that has the ability to scale to the operator's needs. In this configuration it is completely barebones, with just the plate bags and cummerbunds to use beneath a chest rig or other external carrying systems. Manufactured by T.REX ARMS. MultiCam version."
      }
    },
