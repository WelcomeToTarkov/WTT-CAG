      "en": {
        "name": "Ferro Concepts Slickster plate carrier (MultiCam)",
        "shortName": "Slickster",
        "description": "The Slickster is a slim plate carrier designed as a minimalistic multi-mission plate carrier for law enforcement and military use as part of Ferro's wider ADAPT system. This carrier features internal pouches on the cummerbund that allows for more storage of standard magazines or any other item that may fit. Manufactured by Ferro Concepts."
      }
    },
