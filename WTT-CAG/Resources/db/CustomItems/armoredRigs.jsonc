    "locales": {
      "en": {
        "name": "6B46 plate carrier (EMR)",
        "shortName": "6B46",
        "description": "A modular plate carrier and chest rig system combining lightweight profile with extensive MOLLE webbing for gear attachment. Designed to accept front and rear ballistic plates or be used as a rig without plates, the 6B46 strikes a balance between mobility and protection for airborne and light infantry roles in versatile engagements. EMR version."
      }
    },
