    "locales": {
      "en": {
        "name": "Crye Precision JPC 2.0 plate carrier (MultiCam Tropic)",
        "shortName": "JPC",
        "description": "The widely beloved Jumpable Plate Carrier (JPC) was designed to maximize operator mobility by reducing weight and bulk. Its modular system allows for personalized loadouts and quick gear adjustments depending on the mission. Manufactured by Crye Precision. MultiCam Tropic version."
      }
    },
