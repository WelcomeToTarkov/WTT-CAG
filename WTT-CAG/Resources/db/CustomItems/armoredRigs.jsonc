    "locales": {
      "en": {
        "name": "Velmet Perun-6 SOF LC plate carrier (MaWka)",
        "shortName": "Perun-6",
        "description": "The Perun 6 LC SOF is a modernized shell of the Perun 6 body armor. The main improvements include changes in ergonomics to take into account the specifics of the tasks performed by special forces of the Armed Forces of Ukraine, equipped with MBZ soft ballistic inserts for extra protection when used alongside a ballistic plate. MaWka Woodland version."
      }
    },
