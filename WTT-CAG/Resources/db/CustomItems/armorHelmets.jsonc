    "locales": {
      "en": {
        "name": "Ceradyne IHPS Ballistic helmet (Coyote Tan)",
        "shortName": "IHPS",
        "description": "A modular ballistic ballistic helmet system developed for U.S. SOCOM, the IHPS can be configured with front and side ARC rails, night vision shroud, and modular mandible or visor attachments while maintaining high ballistic protection. Its unique “crownless” suspension design reduces weight and improves balance for long-duration use without sacrificing protection."
      }
    },
