    "locales": {
      "en": {
        "name": "Team Wendy RIFLETECH ballistic helmet (MultiCam)",
        "shortName": "RIFLETECH",
        "description": "A modern rifle-rated ballistic helmet manufactured by Team Wendy. Built using advanced polyethylene composite materials and a seamless shell architecture, the RIFLETECH offers protection against a wide range of battlefield threats while maintaining reduced weight compared to conventional combat helmets. Equipped with an Air FIT liner system, CAM FIT retention harness, integrated night vision shroud, and modular side rails for mounting tactical accessories. MultiCam version."
      }
    },
